    "typecheck": "npm run typecheck -w server && npm run typecheck -w client"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "overrides": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
